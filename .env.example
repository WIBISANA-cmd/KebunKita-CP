# Kosongkan project ID untuk menjalankan website dengan konten bawaan.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Token Viewer dari sanity.io/manage, dipakai untuk pratinjau draf.
SANITY_API_READ_TOKEN=

# Teks acak yang sama dengan secret pada webhook Sanity.
SANITY_REVALIDATE_SECRET=

# Domain produksi, dipakai untuk metadata, sitemap, dan data terstruktur.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
